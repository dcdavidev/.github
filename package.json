{
  "name": "@dcdavidev/dotgithub",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub special repository",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "commit": "czg",
    "fmt": "prettier --ignore-unknown --write .",
    "fmt:check": "prettier --ignore-unknown --check .",
    "lint": "pnpm run lint:code && pnpm run lint:spelling",
    "lint:code": "eslint --no-warn-ignored .",
    "lint:code:fix": "eslint --no-warn-ignored --fix .",
    "lint:commits": "commitlint --from=HEAD~1 --verbose",
    "lint:spelling": "cspell --no-progress --no-summary .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@spellbookx/recipes": "^1.3.0",
    "commitlint-config-spellbookx": "^1.3.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cspell": "^10.5.2",
    "cspell-config-spellbookx": "^1.3.0",
    "cz-config-spellbookx": "^1.3.0",
    "czg": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-plugin-spellbookx": "^1.3.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-config-spellbookx": "^1.3.0"
  },
  "packageManager": "pnpm@12.23.0"
}
